{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickdraw.local/schemas/bdq-third-update-smoke-result.schema.json",
  "title": "QuickDraw third optimizer update smoke result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_sha256",
    "fresh_process_count",
    "exact_trace_equality",
    "canonical_trace_sha256",
    "canonical_trace"
  ],
  "properties": {
    "schema_version": {"const": "quickdraw.bdq-third-update-smoke-result.v1"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "fresh_process_count": {"const": 2},
    "exact_trace_equality": {"const": true},
    "canonical_trace_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_trace": {"$ref": "#/$defs/trace"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mask3": {
      "type": "array",
      "items": {"type": "boolean"},
      "minItems": 3,
      "maxItems": 3
    },
    "mask2": {
      "type": "array",
      "items": {"type": "boolean"},
      "minItems": 2,
      "maxItems": 2
    },
    "masks": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/mask3"},
        {"$ref": "#/$defs/mask2"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "action": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 2},
        {"type": "integer", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "episode_index",
        "episode_decision_index",
        "observation_sha256",
        "next_observation_sha256",
        "observation_shape",
        "action",
        "reward",
        "action_masks",
        "next_action_masks",
        "terminated",
        "truncated"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 10007},
        "episode_index": {"type": "integer", "minimum": 0},
        "episode_decision_index": {"type": "integer", "minimum": 0, "maximum": 299},
        "observation_sha256": {"$ref": "#/$defs/sha256"},
        "next_observation_sha256": {"$ref": "#/$defs/sha256"},
        "observation_shape": {"const": [84, 84, 4]},
        "action": {"$ref": "#/$defs/action"},
        "reward": {"type": "number"},
        "action_masks": {"$ref": "#/$defs/masks"},
        "next_action_masks": {"$ref": "#/$defs/masks"},
        "terminated": {"type": "boolean"},
        "truncated": {"type": "boolean"}
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_index",
        "transition_start_index",
        "transition_count",
        "return",
        "end_kind",
        "reason",
        "interrupted",
        "unity_episode_ended"
      ],
      "properties": {
        "episode_index": {"type": "integer", "minimum": 0},
        "transition_start_index": {"type": "integer", "minimum": 0, "maximum": 10007},
        "transition_count": {"type": "integer", "minimum": 1, "maximum": 300},
        "return": {"type": "number"},
        "end_kind": {"enum": ["terminal", "truncated", "collection_cutoff"]},
        "reason": {"enum": ["target_hit", "decision_limit", "collection_limit"]},
        "interrupted": {"type": "boolean"},
        "unity_episode_ended": {"type": "boolean"}
      }
    },
    "truncation_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_index",
        "decision_count",
        "reason",
        "position_slot",
        "next_action_masks"
      ],
      "properties": {
        "episode_index": {"type": "integer", "minimum": 0},
        "decision_count": {"const": 300},
        "reason": {"const": "decision_limit"},
        "position_slot": {"type": "integer", "minimum": -4, "maximum": 4},
        "next_action_masks": {"$ref": "#/$defs/masks"}
      }
    },
    "optimization_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_count",
        "replay_size",
        "optimizer_update_count",
        "target_sync_count",
        "updated",
        "target_synced",
        "loss",
        "mean_absolute_td_error",
        "online_after_sha256"
      ],
      "properties": {
        "decision_count": {"enum": [10000, 10004, 10008]},
        "replay_size": {"enum": [10000, 10004, 10008]},
        "optimizer_update_count": {"type": "integer", "minimum": 1, "maximum": 3},
        "target_sync_count": {"const": 0},
        "updated": {"const": true},
        "target_synced": {"const": false},
        "loss": {"type": "number", "minimum": 0},
        "mean_absolute_td_error": {"type": "number", "minimum": 0},
        "online_after_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "contract_sha256",
        "behavior",
        "scenario_seed",
        "policy_seed",
        "selector",
        "execution_determinism",
        "episodes",
        "completed_episode_count",
        "episode_reset_count",
        "truncation_events",
        "transitions",
        "replay",
        "cutoff",
        "optimization"
      ],
      "properties": {
        "schema_version": {"const": "quickdraw.bdq-third-update-trace.v1"},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "behavior": {
          "const": {
            "name": "QuickDrawResearchBasic",
            "observation_shape": [84, 84, 4],
            "wire_layout": "HWC",
            "dtype": "float32",
            "discrete_branches": [3, 2],
            "privileged_observation_count": 0
          }
        },
        "scenario_seed": {"const": 31001},
        "policy_seed": {"const": 51001},
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "epsilon_decay_enabled",
            "exploration_seed",
            "selection_count",
            "full_exploration_selection_count",
            "decay_selection_count",
            "first_decay_completed_transition_count",
            "completed_transition_count_source",
            "first_selection_completed_transition_count",
            "last_selection_completed_transition_count",
            "epsilon_samples",
            "action_tuple_counts",
            "unique_action_tuple_count"
          ],
          "properties": {
            "name": {"const": "seeded_scheduled_branch_epsilon_greedy"},
            "epsilon_decay_enabled": {"const": true},
            "exploration_seed": {"const": 61001},
            "selection_count": {"const": 10008},
            "full_exploration_selection_count": {"const": 10001},
            "decay_selection_count": {"const": 7},
            "first_decay_completed_transition_count": {"const": 10001},
            "completed_transition_count_source": {"const": "BDQOptimizerController.decision_count"},
            "first_selection_completed_transition_count": {"const": 0},
            "last_selection_completed_transition_count": {"const": 10007},
            "epsilon_samples": {
              "const": [
                {"completed_transition_count": 0, "epsilon": 1.0},
                {"completed_transition_count": 10000, "epsilon": 1.0},
                {"completed_transition_count": 10001, "epsilon": 0.999991},
                {"completed_transition_count": 10004, "epsilon": 0.999964},
                {"completed_transition_count": 10005, "epsilon": 0.999955},
                {"completed_transition_count": 10006, "epsilon": 0.999946},
                {"completed_transition_count": 10007, "epsilon": 0.999937}
              ]
            },
            "action_tuple_counts": {
              "type": "array",
              "items": {"type": "integer", "minimum": 0, "maximum": 10008},
              "minItems": 6,
              "maxItems": 6
            },
            "unique_action_tuple_count": {"const": 6}
          }
        },
        "execution_determinism": {
          "const": {
            "torch_num_threads": 1,
            "torch_num_interop_threads": 1,
            "deterministic_algorithms": true
          }
        },
        "episodes": {
          "type": "array",
          "items": {"$ref": "#/$defs/episode"},
          "minItems": 2,
          "maxItems": 10008
        },
        "completed_episode_count": {"type": "integer", "minimum": 1, "maximum": 10008},
        "episode_reset_count": {"type": "integer", "minimum": 1, "maximum": 10008},
        "truncation_events": {
          "type": "array",
          "items": {"$ref": "#/$defs/truncation_event"},
          "maxItems": 34
        },
        "transitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/transition"},
          "minItems": 10008,
          "maxItems": 10008
        },
        "replay": {
          "const": {
            "decision_count": 10008,
            "size": 10008,
            "capacity": 100000,
            "warmup_decisions": 10000,
            "below_warmup": false,
            "at_warmup": false
          }
        },
        "cutoff": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transition_limit",
            "pending_agent_ids",
            "pending_decision_count",
            "active_episode_index",
            "ended_on_unity_boundary"
          ],
          "properties": {
            "transition_limit": {"const": 10008},
            "pending_agent_ids": {"const": []},
            "pending_decision_count": {"const": 0},
            "active_episode_index": {"type": "integer", "minimum": 0},
            "ended_on_unity_boundary": {"type": "boolean"}
          }
        },
        "optimization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "optimizer_update_count",
            "target_sync_count",
            "update_events",
            "online_before_sha256",
            "online_after_sha256",
            "target_before_sha256",
            "target_after_sha256",
            "online_weights_changed",
            "target_weights_unchanged"
          ],
          "properties": {
            "optimizer_update_count": {"const": 3},
            "target_sync_count": {"const": 0},
            "update_events": {
              "type": "array",
              "items": {"$ref": "#/$defs/optimization_event"},
              "minItems": 3,
              "maxItems": 3
            },
            "online_before_sha256": {"const": "b605debdd6073caa41a95d636bcf20b35d000dc959b06d5cbe585cac0bb433bb"},
            "online_after_sha256": {"$ref": "#/$defs/sha256"},
            "target_before_sha256": {"const": "b605debdd6073caa41a95d636bcf20b35d000dc959b06d5cbe585cac0bb433bb"},
            "target_after_sha256": {"const": "b605debdd6073caa41a95d636bcf20b35d000dc959b06d5cbe585cac0bb433bb"},
            "online_weights_changed": {"const": true},
            "target_weights_unchanged": {"const": true}
          }
        }
      }
    }
  }
}
