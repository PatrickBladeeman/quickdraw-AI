{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PatrickBladeeman/quickdraw-AI/Research/schemas/rocm-mlagents-compatibility.schema.json",
  "title": "quickdraw-AI R1E ROCm and ML-Agents compatibility result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_utc",
    "repository",
    "inputs",
    "system",
    "software",
    "rocm",
    "communicator",
    "errors",
    "decision"
  ],
  "properties": {
    "schema_version": {
      "const": "quickdraw.r1e-rocm-mlagents-compatibility-result.v1"
    },
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
    "created_utc": {"type": "string", "format": "date-time"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_sha256",
        "support_lock_sha256",
        "builder_sha256",
        "preparer_sha256",
        "probe_sha256",
        "result_schema_sha256",
        "manifest_schema_sha256",
        "smoke_runner_sha256",
        "cpu_lock_sha256"
      ],
      "properties": {
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "support_lock_sha256": {"$ref": "#/$defs/sha256"},
        "builder_sha256": {"$ref": "#/$defs/sha256"},
        "preparer_sha256": {"$ref": "#/$defs/sha256"},
        "probe_sha256": {"$ref": "#/$defs/sha256"},
        "result_schema_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_schema_sha256": {"$ref": "#/$defs/sha256"},
        "smoke_runner_sha256": {"$ref": "#/$defs/sha256"},
        "cpu_lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "cpu", "memory_bytes", "gpus", "amd_software"],
      "properties": {
        "os": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "build", "display_version"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "build": {"type": "string", "minLength": 1},
            "display_version": {"const": "25H2"}
          }
        },
        "cpu": {"type": "string", "minLength": 1},
        "memory_bytes": {"type": "integer", "minimum": 1},
        "gpus": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "driver_version"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "driver_version": {"type": "string", "minLength": 1}
            }
          }
        },
        "amd_software": {"const": "26.7.1"}
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python_version",
        "packages",
        "overlay_valid",
        "pip_check",
        "imports",
        "mlagents_cli"
      ],
      "properties": {
        "python_version": {"const": "3.11.13"},
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mlagents",
            "mlagents-envs",
            "PettingZoo",
            "grpcio",
            "numpy",
            "rocm",
            "torch",
            "torchvision",
            "torchaudio"
          ],
          "properties": {
            "mlagents": {"const": "1.1.0"},
            "mlagents-envs": {"const": "1.1.0"},
            "PettingZoo": {"const": "1.15.0"},
            "grpcio": {"const": "1.53.2"},
            "numpy": {"const": "1.23.5"},
            "rocm": {"const": "7.14.0"},
            "torch": {"const": "2.12.0+rocm7.14.0"},
            "torchvision": {"const": "0.27.0+rocm7.14.0"},
            "torchaudio": {"const": "2.11.0+rocm7.14.0"}
          }
        },
        "overlay_valid": {"const": true},
        "pip_check": {"const": true},
        "imports": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mlagents",
            "mlagents_envs",
            "torch",
            "torchvision",
            "torchaudio"
          ],
          "properties": {
            "mlagents": {"const": true},
            "mlagents_envs": {"const": true},
            "torch": {"const": true},
            "torchvision": {"const": true},
            "torchaudio": {"const": true}
          }
        },
        "mlagents_cli": {"const": true}
      }
    },
    "rocm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "hip_version",
        "devices",
        "selected_device",
        "forward_max_abs",
        "input_gradient_max_abs",
        "weight_gradient_max_abs",
        "finite",
        "tolerances_passed"
      ],
      "properties": {
        "available": {"const": true},
        "hip_version": {"const": "7.14.60850"},
        "devices": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "selected_device": {
          "type": "object",
          "additionalProperties": false,
          "required": ["index", "name", "torch_device", "mlagents_default_device"],
          "properties": {
            "index": {"type": "integer", "minimum": 0},
            "name": {"const": "AMD Radeon RX 7900 XT"},
            "torch_device": {"type": "string", "pattern": "^cuda:[0-9]+$"},
            "mlagents_default_device": {"type": "string", "pattern": "^cuda:[0-9]+$"}
          }
        },
        "forward_max_abs": {"type": "number", "minimum": 0, "maximum": 0.00001},
        "input_gradient_max_abs": {"type": "number", "minimum": 0, "maximum": 0.00001},
        "weight_gradient_max_abs": {"type": "number", "minimum": 0, "maximum": 0.00001},
        "finite": {"const": true},
        "tolerances_passed": {"const": true}
      }
    },
    "communicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_count",
        "trace_sha256",
        "traces_identical",
        "manifests_valid",
        "unity_communication"
      ],
      "properties": {
        "run_count": {"const": 2},
        "trace_sha256": {"$ref": "#/$defs/sha256"},
        "traces_identical": {"const": true},
        "manifests_valid": {"const": true},
        "unity_communication": {"const": true}
      }
    },
    "errors": {"type": "array", "maxItems": 0},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "backend_acceptance",
        "cpu_reference_retained",
        "full_parity_executed"
      ],
      "properties": {
        "status": {"const": "conditional_go"},
        "backend_acceptance": {"const": "not_accepted"},
        "cpu_reference_retained": {"const": true},
        "full_parity_executed": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
