{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickdraw.local/schemas/bdq-checkpoint-contract.schema.json",
  "title": "QuickDraw trainer checkpoint round-trip contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "purpose",
    "base_fifth_update_contract",
    "runtime",
    "package",
    "checkpoint_boundary",
    "reference_workload",
    "determinism",
    "exclusions"
  ],
  "properties": {
    "schema_version": {"const": "quickdraw.bdq-checkpoint.v1"},
    "task": {"const": "R3P"},
    "purpose": {"type": "string", "minLength": 1},
    "base_fifth_update_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version", "pushed_commit"],
      "properties": {
        "path": {"const": "Research/trainer/bdq-fifth-update-contract-v1.json"},
        "sha256": {"const": "35dcd10971878bef31d8e2dd9392599cd71607a009ac6cb8d93bff3857eadcb0"},
        "schema_version": {"const": "quickdraw.bdq-fifth-update.v1"},
        "pushed_commit": {"const": "028143fff494c6234fd17832dd41199aee5a6fad"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "mlagents_envs", "numpy", "torch", "device"],
      "properties": {
        "python": {"const": "3.11.13"},
        "mlagents_envs": {"const": "1.1.0"},
        "numpy": {"const": "1.23.5"},
        "torch": {"const": "2.12.0+cpu"},
        "device": {"const": "cpu"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "version", "metadata_path", "trainer_entry_points"],
      "properties": {
        "distribution": {"const": "quickdraw-bdq-trainer"},
        "version": {"const": "0.3.0"},
        "metadata_path": {"const": "Research/trainer/pyproject.toml"},
        "trainer_entry_points": {"const": []}
      }
    },
    "checkpoint_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "clean_boundary_required",
        "saved_state",
        "state_integrity",
        "rejections",
        "failure_mode"
      ],
      "properties": {
        "schema_version": {"const": "quickdraw.bdq-checkpoint.v1"},
        "clean_boundary_required": {"const": true},
        "saved_state": {
          "const": [
            "online network",
            "target network",
            "Adam optimizer state",
            "optimizer update and target synchronization counters",
            "completed-transition count",
            "replay contents, ring cursor, accounting metrics, and sampling RNG state",
            "scheduled-selector RNG stream",
            "package, runtime, settings, seeds, and contract identity",
            "boundary verification summary"
          ]
        },
        "state_integrity": {"const": "SHA-256 over the canonical encoded state subtree"},
        "rejections": {
          "const": [
            "unreadable or non-JSON files",
            "schema-incomplete checkpoints",
            "state hash mismatch after corruption",
            "schema-version, contract, package, runtime, settings, or seed drift"
          ]
        },
        "failure_mode": {"const": "reject before any restored object is returned"}
      }
    },
    "reference_workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "controller_seed",
        "exploration_seed",
        "agent_id",
        "schedule",
        "settings",
        "observation_frames",
        "next_observation_frames",
        "action_masks",
        "actions",
        "reward",
        "terminated",
        "truncated",
        "transitions_before_checkpoint",
        "optimizer_updates_at_save",
        "replay_size_at_save",
        "replay_cursor_at_save",
        "replay_unique_frames_at_save",
        "continuation_transitions",
        "next_update_decision_count",
        "bounded_optimizer_updates_after_restore"
      ],
      "properties": {
        "class": {"const": "synthetic deterministic transitions driven through the production collector and scheduled selector"},
        "controller_seed": {"const": 51001},
        "exploration_seed": {"const": 61001},
        "agent_id": {"const": 0},
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replay_warmup_decisions",
            "decay_decisions",
            "initial_epsilon",
            "final_epsilon"
          ],
          "properties": {
            "replay_warmup_decisions": {"const": 10000},
            "decay_decisions": {"const": 100000},
            "initial_epsilon": {"const": 1.0},
            "final_epsilon": {"const": 0.1}
          }
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replay_capacity",
            "replay_warmup_decisions",
            "batch_size",
            "gamma",
            "learning_rate",
            "optimizer_update_interval_decisions",
            "hard_target_sync_interval_optimizer_updates",
            "device"
          ],
          "properties": {
            "replay_capacity": {"const": 32},
            "replay_warmup_decisions": {"const": 24},
            "batch_size": {"const": 8},
            "gamma": {"const": 0.99},
            "learning_rate": {"const": 0.0001},
            "optimizer_update_interval_decisions": {"const": 4},
            "hard_target_sync_interval_optimizer_updates": {"const": 10000},
            "device": {"const": "cpu"}
          }
        },
        "observation_frames": {"const": "constant float32 (i mod 20)/20 frame per stack slot"},
        "next_observation_frames": {"const": "constant float32 ((i + 1) mod 20)/20 frame per stack slot"},
        "action_masks": {"const": "every action available on both branches"},
        "actions": {"const": "scheduled epsilon-greedy selection at completed-transition count i"},
        "reward": {"const": "(i mod 5) - 2"},
        "terminated": {"const": "i mod 11 == 10"},
        "truncated": {"const": "i mod 7 == 6"},
        "transitions_before_checkpoint": {"const": 36},
        "optimizer_updates_at_save": {"const": 4},
        "replay_size_at_save": {"const": 32},
        "replay_cursor_at_save": {"const": 4},
        "replay_unique_frames_at_save": {"const": 20},
        "continuation_transitions": {"const": 4},
        "next_update_decision_count": {"const": 40},
        "bounded_optimizer_updates_after_restore": {"const": 1}
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_processes",
        "reference_and_saver_boundaries_identical",
        "restored_boundary_matches_reference",
        "same_next_replay_sample",
        "same_next_optimizer_result",
        "checkpoint_file_bytes_deterministic",
        "unity_player_required",
        "torch_num_threads",
        "torch_num_interop_threads",
        "deterministic_algorithms"
      ],
      "properties": {
        "fresh_processes": {"const": 3},
        "reference_and_saver_boundaries_identical": {"const": true},
        "restored_boundary_matches_reference": {"const": true},
        "same_next_replay_sample": {"const": true},
        "same_next_optimizer_result": {"const": true},
        "checkpoint_file_bytes_deterministic": {"const": true},
        "unity_player_required": {"const": false},
        "torch_num_threads": {"const": 1},
        "torch_num_interop_threads": {"const": 1},
        "deterministic_algorithms": {"const": true}
      }
    },
    "exclusions": {
      "const": [
        "a Unity rollout, live LLAPI collection, or any new environment interaction",
        "transition 10017 on the R3O trajectory",
        "optimizer update 6 on the R3O trajectory",
        "an action selected with update-5 weights",
        "target-network synchronization",
        "extended training",
        "final checkpoint selection",
        "ONNX export or exported-inference parity",
        "ROCm execution or training",
        "multi-environment collection",
        "policy-effectiveness or sample-efficiency claims"
      ]
    }
  }
}
