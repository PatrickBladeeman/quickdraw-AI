        "sha256": {"const": "d0803181993a9b31d089a483fc0e4499980ec5893625be5a9188e0db68c7153d"},
        "schema_version": {"const": "quickdraw.research-basic.v1"}
      }
    },
    "update_schedule": {
      "type": "object",
