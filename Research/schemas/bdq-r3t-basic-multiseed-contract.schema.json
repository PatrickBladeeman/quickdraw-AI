      "required": ["ordinal", "run_id", "policy_initialization_seed", "replay_sampling_seed", "exploration_seed", "scenario_seed"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 5},
        "run_id": {"type": "string", "pattern": "^seed-5100[1-5]$"},
        "policy_initialization_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "replay_sampling_seed": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "exploration_seed": {"const": 61001},
        "scenario_seed": {"const": 31001}
      }
