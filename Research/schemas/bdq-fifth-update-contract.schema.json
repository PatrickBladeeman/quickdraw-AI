{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickdraw.local/schemas/bdq-fifth-update-contract.schema.json",
  "title": "QuickDraw fifth optimizer update contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "purpose",
    "base_fourth_update_contract",
    "base_replay_storage_contract",
    "runtime",
    "package",
    "transport",
    "player_execution",
    "collection",
    "optimization",
    "epsilon_schedule",
    "r3m_prefix",
    "fifth_update_boundary",
    "determinism",
    "exclusions"
  ],
  "properties": {
    "schema_version": {"const": "quickdraw.bdq-fifth-update.v1"},
    "task": {"const": "R3O"},
    "purpose": {"type": "string", "minLength": 1},
    "base_fourth_update_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version", "pushed_commit"],
      "properties": {
        "path": {"const": "Research/trainer/bdq-fourth-update-contract-v1.json"},
        "sha256": {"const": "0a6f209d93ef6d522a53f24807d4ce48e6e820a344905e9762583bbe13a72dbb"},
        "schema_version": {"const": "quickdraw.bdq-fourth-update.v1"},
        "pushed_commit": {"const": "2ec3ec39d25d5d3bb5686574255898f3f5605d3f"}
      }
    },
    "base_replay_storage_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version", "pushed_commit"],
      "properties": {
        "path": {"const": "Research/trainer/bdq-replay-storage-contract-v1.json"},
        "sha256": {"const": "ece35b60208adbb9ca0d36f8d61b3be652aae4a94ffdb7d2bcafc9ace58e16a9"},
        "schema_version": {"const": "quickdraw.bdq-replay-storage.v1"},
        "pushed_commit": {"const": "ca66335ce4e413ce7c4c35827d71154a254b850e"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "mlagents_envs", "numpy", "torch", "device"],
      "properties": {
        "python": {"const": "3.11.13"},
        "mlagents_envs": {"const": "1.1.0"},
        "numpy": {"const": "1.23.5"},
        "torch": {"const": "2.12.0+cpu"},
        "device": {"const": "cpu"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "version", "metadata_path", "trainer_entry_points"],
      "properties": {
        "distribution": {"const": "quickdraw-bdq-trainer"},
        "version": {"const": "0.3.0"},
        "metadata_path": {"const": "Research/trainer/pyproject.toml"},
        "trainer_entry_points": {"const": []}
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "behavior_name",
        "agent_count",
        "observation_shape",
        "observation_layout",
        "observation_dtype",
        "discrete_branches",
        "transition_completion",
        "truncation_mask_transport",
        "privileged_scene_inference_permitted"
      ],
      "properties": {
        "api": {"const": "mlagents_envs.environment.UnityEnvironment"},
        "behavior_name": {"const": "QuickDrawResearchBasic"},
        "agent_count": {"const": 1},
        "observation_shape": {"const": [84, 84, 4]},
        "observation_layout": {"const": "HWC"},
        "observation_dtype": {"const": "float32"},
        "discrete_branches": {"const": [3, 2]},
        "transition_completion": {"const": "complete the pending action when the same agent next appears in DecisionSteps or TerminalSteps"},
        "truncation_mask_transport": {"const": "quickdraw.basic-truncation-mask.v1"},
        "privileged_scene_inference_permitted": {"const": false}
      }
    },
    "player_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_settings_path",
        "run_in_background",
        "no_graphics",
        "standalone_player_arguments"
      ],
      "properties": {
        "project_settings_path": {"const": "ProjectSettings/ProjectSettings.asset"},
        "run_in_background": {"const": true},
        "no_graphics": {"const": false},
        "standalone_player_arguments": {"const": []}
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_seed",
        "policy_seed",
        "exploration_seed",
        "selector",
        "epsilon_decay_enabled",
        "scheduled_transition_count",
        "transition_limit",
        "minimum_completed_episodes",
        "minimum_unique_action_tuples",
        "require_no_pending_decision_at_cutoff"
      ],
      "properties": {
        "scenario_seed": {"const": 31001},
        "policy_seed": {"const": 51001},
        "exploration_seed": {"const": 61001},
        "selector": {"const": "seeded_scheduled_branch_epsilon_greedy"},
        "epsilon_decay_enabled": {"const": true},
        "scheduled_transition_count": {"const": 10016},
        "transition_limit": {"const": 10016},
        "minimum_completed_episodes": {"const": 1},
        "minimum_unique_action_tuples": {"const": 6},
        "require_no_pending_decision_at_cutoff": {"const": true}
      }
    },
    "optimization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replay_capacity",
        "replay_warmup_decisions",
        "batch_size",
        "gamma",
        "optimizer",
        "learning_rate",
        "optimizer_update_interval_decisions",
        "hard_target_sync_interval_optimizer_updates",
        "expected_first_update_decision",
        "expected_update_decisions",
        "expected_optimizer_updates",
        "expected_target_synchronizations",
        "require_finite_loss",
        "require_finite_mean_absolute_td_error",
        "require_online_weights_changed_after_each_update",
        "require_target_weights_unchanged"
      ],
      "properties": {
        "replay_capacity": {"const": 100000},
        "replay_warmup_decisions": {"const": 10000},
        "batch_size": {"const": 64},
        "gamma": {"const": 0.99},
        "optimizer": {"const": "Adam"},
        "learning_rate": {"const": 0.0001},
        "optimizer_update_interval_decisions": {"const": 4},
        "hard_target_sync_interval_optimizer_updates": {"const": 10000},
        "expected_first_update_decision": {"const": 10000},
        "expected_update_decisions": {"const": [10000, 10004, 10008, 10012, 10016]},
        "expected_optimizer_updates": {"const": 5},
        "expected_target_synchronizations": {"const": 0},
        "require_finite_loss": {"const": true},
        "require_finite_mean_absolute_td_error": {"const": true},
        "require_online_weights_changed_after_each_update": {"const": true},
        "require_target_weights_unchanged": {"const": true}
      }
    },
    "epsilon_schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "selector_class",
        "completed_transition_count_source",
        "replay_warmup_decisions",
        "decay_decisions",
        "initial_epsilon",
        "final_epsilon",
        "trace_sample_completed_transition_counts",
        "trace_sample_epsilons",
        "selection_count",
        "full_exploration_selection_count",
        "decay_selection_count",
        "first_decay_completed_transition_count",
        "last_selection_completed_transition_count",
        "continuous_selector_rng_from_completed_count_zero"
      ],
      "properties": {
        "class": {"const": "quickdraw_bdq.exploration.LinearEpsilonSchedule"},
        "selector_class": {"const": "quickdraw_bdq.llapi.ScheduledEpsilonGreedyBDQActionSelector"},
        "completed_transition_count_source": {"const": "BDQOptimizerController.decision_count"},
        "replay_warmup_decisions": {"const": 10000},
        "decay_decisions": {"const": 100000},
        "initial_epsilon": {"const": 1.0},
        "final_epsilon": {"const": 0.1},
        "trace_sample_completed_transition_counts": {
          "const": [0, 10000, 10001, 10004, 10005, 10006, 10007, 10008, 10009, 10010, 10011, 10012, 10013, 10014, 10015]
        },
        "trace_sample_epsilons": {
          "const": [1.0, 1.0, 0.999991, 0.999964, 0.999955, 0.999946, 0.999937, 0.999928, 0.999919, 0.99991, 0.999901, 0.999892, 0.999883, 0.999874, 0.999865]
        },
        "selection_count": {"const": 10016},
        "full_exploration_selection_count": {"const": 10001},
        "decay_selection_count": {"const": 15},
        "first_decay_completed_transition_count": {"const": 10001},
        "last_selection_completed_transition_count": {"const": 10015},
        "continuous_selector_rng_from_completed_count_zero": {"const": true}
      }
    },
    "r3m_prefix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_count",
        "canonical_transitions_sha256",
        "source_canonical_trace_sha256",
        "online_after_first_update_sha256",
        "online_after_second_update_sha256",
        "online_after_third_update_sha256",
        "online_after_fourth_update_sha256",
        "frozen_target_sha256",
        "first_update_loss",
        "first_update_mean_absolute_td_error",
        "second_update_loss",
        "second_update_mean_absolute_td_error",
        "third_update_loss",
        "third_update_mean_absolute_td_error",
        "fourth_update_loss",
        "fourth_update_mean_absolute_td_error"
      ],
      "properties": {
        "transition_count": {"const": 10012},
        "canonical_transitions_sha256": {"const": "9b3fc70c5e3cdbc40c9332460ef702304086aa6d07c8467a411c31bcba059bef"},
        "source_canonical_trace_sha256": {"const": "cd2fa70672432e74c16c34c0525035953961ac3845cbe3362e061373cf48a940"},
        "online_after_first_update_sha256": {"const": "7dd2365b5e219af10aeb4fabb5191df873762fcea6765cb50f83d41525279c8e"},
        "online_after_second_update_sha256": {"const": "6248f286191da322a52ad0c97f569d30ecd49a1c86e9810bda4cb96ccc6b9471"},
        "online_after_third_update_sha256": {"const": "4f78e397e87ad6cea1ada78d49dea808337c401f6478970d1a4439065743775b"},
        "online_after_fourth_update_sha256": {"const": "a8356df1531b99a42966578c6fd784cd384c8bcd3d3c3092124df13b2587268f"},
        "frozen_target_sha256": {"const": "b605debdd6073caa41a95d636bcf20b35d000dc959b06d5cbe585cac0bb433bb"},
        "first_update_loss": {"const": 0.01628389209508896},
        "first_update_mean_absolute_td_error": {"const": 0.06243317946791649},
        "second_update_loss": {"const": 0.014819225296378136},
        "second_update_mean_absolute_td_error": {"const": 0.06711231172084808},
        "third_update_loss": {"const": 0.008735351264476776},
        "third_update_mean_absolute_td_error": {"const": 0.06769348680973053},
        "fourth_update_loss": {"const": 0.0085072573274374},
        "fourth_update_mean_absolute_td_error": {"const": 0.06249994412064552}
      }
    },
    "fifth_update_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continuation_after_transition_count",
        "new_transition_count",
        "first_new_selection_completed_transition_count",
        "last_new_selection_completed_transition_count",
        "completion_decision_count",
        "optimizer_update_count_before_continuation",
        "optimizer_update_count_after_completion",
        "target_sync_count_after_completion",
        "select_action_after_fifth_update",
        "require_online_weights_changed_by_fifth_update",
        "require_frozen_target_network",
        "require_no_pending_decision_after_completion"
      ],
      "properties": {
        "continuation_after_transition_count": {"const": 10012},
        "new_transition_count": {"const": 4},
        "first_new_selection_completed_transition_count": {"const": 10012},
        "last_new_selection_completed_transition_count": {"const": 10015},
        "completion_decision_count": {"const": 10016},
        "optimizer_update_count_before_continuation": {"const": 4},
        "optimizer_update_count_after_completion": {"const": 5},
        "target_sync_count_after_completion": {"const": 0},
        "select_action_after_fifth_update": {"const": false},
        "require_online_weights_changed_by_fifth_update": {"const": true},
        "require_frozen_target_network": {"const": true},
        "require_no_pending_decision_after_completion": {"const": true}
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_processes",
        "exact_trace_equality",
        "torch_num_threads",
        "torch_num_interop_threads",
        "deterministic_algorithms"
      ],
      "properties": {
        "fresh_processes": {"const": 2},
        "exact_trace_equality": {"const": true},
        "torch_num_threads": {"const": 1},
        "torch_num_interop_threads": {"const": 1},
        "deterministic_algorithms": {"const": true}
      }
    },
    "exclusions": {
      "const": [
        "a sixth optimizer update or any extended training rollout",
        "action selection using optimizer update 5 weights",
        "target-network synchronization",
        "checkpoint, resume, or ONNX export",
        "ROCm execution or training",
        "multi-environment collection",
        "five-seed training or held-out evaluation",
        "learned-policy effectiveness claims",
        "changes to the R2A environment or action contract",
        "changes to the R3N replay representation, sampling, accounting, or storage ceiling",
        "watch-mode camera maintenance",
        "gradual-motion Basic variant",
        "strategic combat, reflex, or LLM runtime"
      ]
    }
  }
}
